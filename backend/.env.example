# ─── Formatly Backend — Environment Variables (example) ──────────────────────
# Rename to .env and fill in real values. Safe to commit — no secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq (priority 1) — https://console.groq.com ─────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini (priority 2) — https://aistudio.google.com/apikey ─────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── OpenRouter (priority 3) — https://openrouter.ai/keys ─────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── HuggingFace (priority 4) — https://huggingface.co/settings/tokens ────────
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Storage ──────────────────────────────────────────────────────────────────
# FORMATLY_DATA_DIR=./backend/.data
