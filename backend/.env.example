# ─── Formatly Backend — Environment Variables (example) ──────────────────────
# Rename to .env and fill in real values. Safe to commit — no secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mistral — https://console.mistral.ai/api-keys ────────────────────────────
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ── Request timeout ──────────────────────────────────────────────────────────
# Left unset, the deadline is derived from the request's token budget (a
# document asking for 8000 tokens gets ~230s). Set a number to override.
# LLM_TIMEOUT=

# ── Storage ──────────────────────────────────────────────────────────────────
# FORMATLY_DATA_DIR=./backend/.data
