# ─── Formatly Backend — Environment Variables (example) ─────────────────────
#
# Rename this file to .env and fill in real values.
# This file is safe to commit — it contains no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Groq API — free tier at https://console.groq.com
GROQ_API_KEY=

# Groq model (optional — defaults to llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Data directory for drafts, exports, templates, charts
# (optional — defaults to backend/.data/)
# FORMATLY_DATA_DIR=./backend/.data
